{
  "version": 2,
  "routes": [
    {
      "src": "/api/auth",
      "dest": "/api/auth"
    },
    {
      "src": "/api/facilities(/.*)?",
      "dest": "/api/facilities"
    },
    {
      "src": "/api/bookings(/.*)?",
      "dest": "/api/bookings"
    },
    {
      "src": "/api/admin(/.*)?",
      "dest": "/api/admin"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "backend/**"
    }
  }
}
